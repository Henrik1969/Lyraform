program preserved_targets
type Inner {
 b : int32
}
type Point {
 x : int32
 a : Inner
}
main {
x : int32(0)
x_value : int32(0)
b_value : int32(0)
p : Point({x:x_value, a:{b:b_value}})
items : list<int32>([0,0])
matrix : array<int32>[2,2]([0,0,0,0])
i : int32(0)
r : int32(0)
c : int32(1)
20 -> x
20 -> p.x
20 -> p.a.b
20 -> items[i]
20 -> matrix[r,c]
x -> return
}
