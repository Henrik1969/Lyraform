#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
    cat <<'EOF'
Usage: tools/run-autonomous-codex --task PATH [options]

Run an explicitly selected Lyraform mission until its local state says DONE or
BLOCKED, or a safety limit is reached. This runner grants no commit, push, or
continuation authority; those permissions belong to the selected mission.

Required:
  --task PATH             Mission document inside this repository

Optional context:
  --state-file PATH       State file; default: local Git state codex/run-state
  --architecture PATH     Explicit architecture context inside this repository
  --ledger PATH            Explicit ledger context inside this repository
  --context PATH           Additional explicit context file (repeatable)

Environment:
  LYRAFORM_CODEX_MAX_ITERATIONS       Maximum turns; default: 20
  LYRAFORM_CODEX_MAX_FAILURES         Consecutive failed turns; default: 2
  LYRAFORM_CODEX_STALL_LIMIT          No-progress turns; default: 3
  LYRAFORM_CODEX_LOG_DIR              Transcript directory; default: /tmp/lyraform-codex-$UID
  LYRAFORM_CODEX_MODEL                Optional explicit Codex model
  LYRAFORM_CODEX_PERMISSION_MODE      auto-review (default) or isolated-full

The default state is resolved with `git rev-parse --git-path codex/run-state`
and initialized locally as CONTINUE when a mission is launched.
EOF
}

die() { echo "error: $*" >&2; exit 64; }
task_arg=''; state_arg=''; architecture_arg=''; ledger_arg=''; context_args=()
while (($#)); do
    case "$1" in
        --help|-h) usage; exit 0 ;;
        --task|--state-file|--architecture|--ledger|--context)
            (($# >= 2)) || die "$1 requires a path"
            case "$1" in
                --task) task_arg=$2 ;; --state-file) state_arg=$2 ;;
                --architecture) architecture_arg=$2 ;; --ledger) ledger_arg=$2 ;;
                --context) context_args+=("$2") ;;
            esac
            shift 2 ;;
        --) shift; (($# == 0)) || die "unexpected positional argument '$1'" ;;
        -*) die "unknown argument '$1'" ;;
        *) die "unexpected positional argument '$1'" ;;
    esac
done
[[ -n $task_arg ]] || die '--task PATH is required'

for required_command in git codex sha256sum realpath; do
    command -v "$required_command" >/dev/null 2>&1 || { echo "$required_command is required" >&2; exit 69; }
done
repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo 'Run this tool from inside a Lyraform Git repository.' >&2; exit 69; }
repo_root=$(realpath "$repo_root"); cd "$repo_root"

repo_file() {
    local raw=$1 candidate resolved
    if [[ $raw = /* ]]; then candidate=$raw; else candidate=$repo_root/$raw; fi
    [[ -f $candidate ]] || { echo "Missing repository file: $raw" >&2; return 66; }
    resolved=$(realpath "$candidate")
    case "$resolved" in
        "$repo_root"/*) printf '%s\n' "$resolved" ;;
        *) echo "Path must remain inside the repository: $raw" >&2; return 66 ;;
    esac
}

task_file=$(repo_file "$task_arg") || exit $?
architecture_file=''; ledger_file=''; context_files=()
if [[ -n $architecture_arg ]]; then architecture_file=$(repo_file "$architecture_arg") || exit $?; fi
if [[ -n $ledger_arg ]]; then ledger_file=$(repo_file "$ledger_arg") || exit $?; fi
for context_arg in "${context_args[@]}"; do context_files+=("$(repo_file "$context_arg")"); done

default_state=$(git rev-parse --git-path codex/run-state)
if [[ $default_state = /* ]]; then state_file=$default_state; else state_file=$repo_root/$default_state; fi
if [[ -n $state_arg ]]; then
    if [[ $state_arg = /* ]]; then state_file=$state_arg; else state_file=$repo_root/$state_arg; fi
fi
state_file=$(realpath -m "$state_file"); mkdir -p "$(dirname "$state_file")"
if [[ ! -e $state_file ]]; then
    printf '%s\n' CONTINUE >"$state_file"
elif [[ ! -f $state_file ]]; then
    echo "State path is not a regular file: $state_file" >&2; exit 65
fi

max_iterations=${LYRAFORM_CODEX_MAX_ITERATIONS:-20}
max_failures=${LYRAFORM_CODEX_MAX_FAILURES:-2}
stall_limit=${LYRAFORM_CODEX_STALL_LIMIT:-3}
log_dir=${LYRAFORM_CODEX_LOG_DIR:-/tmp/lyraform-codex-$UID}
permission_mode=${LYRAFORM_CODEX_PERMISSION_MODE:-auto-review}
for numeric_value in "$max_iterations" "$max_failures" "$stall_limit"; do
    [[ $numeric_value =~ ^[1-9][0-9]*$ ]] || { echo 'Iteration, failure and stall limits must be positive integers.' >&2; exit 64; }
done

read_state() {
    local state; state=$(tr -d '[:space:]' <"$state_file")
    case "$state" in
        CONTINUE|BLOCKED|DONE) printf '%s\n' "$state" ;;
        *) echo "Invalid state '$state' in $state_file" >&2; return 65 ;;
    esac
}
snapshot() {
    { git rev-parse HEAD; git status --porcelain=v1 --untracked-files=all; } |
        sha256sum | awk '{print $1}'
}

codex_command=(codex)
if [[ -n ${LYRAFORM_CODEX_MODEL:-} ]]; then codex_command+=(--model "$LYRAFORM_CODEX_MODEL"); fi
case "$permission_mode" in
    auto-review) codex_command+=(--sandbox workspace-write --ask-for-approval on-request -c approvals_reviewer=auto_review -c sandbox_workspace_write.network_access=true exec) ;;
    isolated-full) codex_command+=(--sandbox danger-full-access --ask-for-approval never exec) ;;
    *) echo "Unknown LYRAFORM_CODEX_PERMISSION_MODE: $permission_mode" >&2; exit 64 ;;
esac
context_text=''
if [[ -n $architecture_file ]]; then context_text+="- $architecture_file\n"; fi
if [[ -n $ledger_file ]]; then context_text+="- $ledger_file\n"; fi
for context_file in "${context_files[@]}"; do context_text+="- $context_file\n"; done
prompt=$(cat <<EOF
Execute the explicitly selected Lyraform mission in:
$task_file

Read the repository AGENTS.md chain and selected mission completely. Do not
treat unselected historical documents as authority. Explicit context files:
${context_text:-none}

Follow only the selected mission's scope and definition of done. This runner
grants no commit, push, or continuation authority. Use those actions only when
the selected mission explicitly authorizes them.
EOF
)

initial_state=$(read_state)
if [[ $initial_state == DONE ]]; then echo 'Mission already reports DONE.'; exit 0; fi
if [[ $initial_state == BLOCKED ]]; then
    echo "Mission reports BLOCKED. Review $task_file." >&2; exit 2
fi
mkdir -p "$log_dir"
export GIT_TERMINAL_PROMPT=0
consecutive_failures=0
consecutive_stalls=0

for ((iteration = 1; iteration <= max_iterations; ++iteration)); do
    state=$(read_state)
    if [[ $state == DONE ]]; then echo 'Mission reports DONE.'; exit 0; fi
    if [[ $state == BLOCKED ]]; then echo "Mission reports BLOCKED. Review $task_file." >&2; exit 2; fi
    before=$(snapshot)
    timestamp=$(date -u +%Y%m%dT%H%M%SZ)
    log_file="$log_dir/iteration-$(printf '%03d' "$iteration")-$timestamp.log"
    echo "Starting Lyraform Codex iteration $iteration of $max_iterations"
    echo "Transcript: $log_file"
    set +e
    "${codex_command[@]}" "$prompt" 2>&1 | tee "$log_file"
    codex_status=${PIPESTATUS[0]}
    set -e
    after=$(snapshot)
    state=$(read_state)
    if ((codex_status == 0)); then
        consecutive_failures=0
    else
        ((consecutive_failures += 1))
        echo "Codex exited with status $codex_status." >&2
    fi
    if [[ $before == "$after" && $state == CONTINUE ]]; then
        ((consecutive_stalls += 1))
        echo 'No Git/worktree progress detected.' >&2
    else
        consecutive_stalls=0
    fi
    if [[ $state == DONE ]]; then echo "Mission reports DONE after iteration $iteration."; exit 0; fi
    if [[ $state == BLOCKED ]]; then echo "Mission reports BLOCKED after iteration $iteration." >&2; exit 2; fi
    if ((consecutive_failures >= max_failures)); then
        echo "Stopping after $consecutive_failures consecutive failed Codex runs." >&2; exit 3
    fi
    if ((consecutive_stalls >= stall_limit)); then
        echo "Stopping after $consecutive_stalls consecutive no-progress runs." >&2; exit 4
    fi
done

echo 'Reached the maximum iteration limit with work remaining.' >&2
exit 5
