program A_records
record Power { value : int32
}
record Duration { value : int32
}
record Energy { value : int64
}
target Demo {
fn energy(p : Power, d : Duration): Energy {
 pw : int64(p.value)
 dt : int64(d.value)
 result : Energy({value: pw * dt})
 result -> return
}
main {
 p : Power({value: 2})
 d : Duration({value: 3})
 e : Energy(energy(d, p))
 if e.value == 6 { 6 -> return } else { 99 -> return }
}
}
