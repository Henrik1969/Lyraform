program A_records
record Power { value : c_long
}
record Duration { value : c_long
}
record Energy { value : c_long
}
target Demo {
fn energy(p : Power, d : Duration): Energy {
 result : Energy({value: p.value * d.value})
 result -> return
}
main {
 p : Power({value: 2})
 d : Duration({value: 3})
 e : Energy(energy(p, d))
 if e.value == 6 { 6 -> return } else { 99 -> return }
}
}
