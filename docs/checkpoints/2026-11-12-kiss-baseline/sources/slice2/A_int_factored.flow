program A_records
record Power { value : int32
}
record Duration { value : int32
}
record Energy { value : int32
}
target Demo {
fn energy(p : Power, d : Duration): Energy {
 pv : int32(p.value)
 dv : int32(d.value)
 product : int32(pv * dv)
 result : Energy({value: product})
 result -> return
}
main {
 p : Power({value: 2})
 d : Duration({value: 3})
 e : Energy(energy(p, d))
 ev : int32(e.value)
 if ev == 6 { 6 -> return } else { 99 -> return }
}
}
