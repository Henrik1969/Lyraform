program shared_scalar_classifier

fn scalar_class(value : int32): int32 {
    digit_low : int32(48)
    digit_high : int32(57)
    digit : int32(1)
    space_code : int32(32)
    whitespace : int32(2)
    other : int32(0)

    if value >= digit_low {
        if value <= digit_high {
            digit -> return
        }
    }
    if value == space_code {
        whitespace -> return
    }
    other -> return
}

fn tokenizer_probe(value : int32): int32 {
    scalar_class(value) -> return
}

fn document_probe(value : int32): int32 {
    scalar_class(value) -> return
}

main {
    scalar : int32(53)
    token_class : int32(0)
    document_class : int32(0)
    mismatch : int32(99)

    tokenizer_probe(scalar) -> token_class
    document_probe(scalar) -> document_class
    if token_class == document_class {
        token_class -> return
    }
    mismatch -> return
}
