import "../../std/math.flow"

program numeric_workbench

type Measurement {
    field value : int32
    field weight : int32
    field accepted : Bool
}

fn weighted_value(item : Measurement): int32 {
    result : int32(0)
    item.value * item.weight -> result
    result -> return
}

fn classify(value : int32): Bool {
    threshold : int32(10)
    value > threshold -> return
}

fn accumulate(values : list<int32>): int32 {
    index : int32(0)
    total : int32(0)
    limit : int32(length(values))
    one : int32(1)

    while index < limit {
        total + values[index] -> total
        index + one -> index
    }

    total -> return
}

main {
    samples : list<int32>([3, 8, 13, 21, 34, 55])
    total : int32(0)
    doubled : int32(0)
    first : Measurement({value:3, weight:2, accepted:false})
    score : int32(0)
    accepted : Bool(false)

    accumulate(samples) -> total
    square(total) -> doubled
    weighted_value(first) -> score
    classify(score) -> accepted

    if accepted {
        print doubled
    } else if total > 50 {
        print total
    } else {
        print score
    }
}
