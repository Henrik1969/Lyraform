program numeric_workbench

type Measurement {
    field value : c_int
    field weight : c_int
    field accepted : Bool
}

fn square_runtime(value : c_int): c_int {
    value * value -> return
}

fn weighted_value(item : Measurement): c_int {
    result : c_int(0)
    item.value * item.weight -> result
    result -> return
}

fn classify(value : c_int): Bool {
    threshold : c_int(10)
    value > threshold -> return
}

fn accumulate(values : list<c_int>): c_int {
    index : c_int(0)
    total : c_int(0)
    limit : c_int(length(values))
    one : c_int(1)

    while index < limit {
        total + values[index] -> total
        index + one -> index
    }

    total -> return
}

main {
    samples : list<c_int>([3, 8, 13, 21, 34, 55])
    total : c_int(0)
    doubled : c_int(0)
    first : Measurement({value:3, weight:2, accepted:false})
    score : c_int(0)
    accepted : Bool(false)

    accumulate(samples) -> total
    square_runtime(total) -> doubled
    weighted_value(first) -> score
    classify(score) -> accepted

    if accepted {
        print doubled
    } else if total > 50 {
        print total
    } else {
        print score
    }
}
