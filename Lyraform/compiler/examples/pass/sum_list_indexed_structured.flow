program sum_list_indexed_structured

main {
    arr     : list<int32>([1,9,3,5,8,2,2,6,4])
    len     : int32(length(arr))
    zero    : int32(0)
    one     : int32(1)
    i       : int32(0)
    current : int32(0)
    sum     : int32(0)

    while i < len {
        arr[i] -> current
        sum + current -> sum
        i + one -> i
    }

    print sum
}
