program fn_iterative_factorial

fn factorial(n : int32): int32 {
    one : int32(1)
    acc : int32(1)

    while n > one {
        acc * n -> acc
        n - one -> n
    }

    acc -> return
}

main {
    n      : int32(stdin.int())
    result : int32(0)

    factorial(n) -> result
    print result
}
