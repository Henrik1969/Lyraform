program nested_break_continue

main {
    outer : int32(0)
    inner : int32(0)
    zero  : int32(0)
    one   : int32(1)
    three : int32(3)

    while outer < three {
        zero -> inner

        while inner < three {
            if inner == one {
                break
            }

            print outer
            inner + one -> inner
        }

        outer + one -> outer
    }
}
