import "../../std/abi/memory.flow"

program abi_memory_demo

main {
    destination : c_pointer(8)
    source      : c_pointer(8)
    count       : c_size_t(8)
    value       : c_int(65)
    result      : c_int(0)

    memset(source, value, count) -> source
    memcpy(destination, source, count) -> destination
    memcmp(destination, source, count) -> result
    print result
}
