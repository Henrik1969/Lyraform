program fibonacci_structured

main {
    n    : int32(stdin.int())
    zero : int32(0)
    one  : int32(1)
    a    : int32(0)
    b    : int32(1)
    i    : int32(0)
    tmp  : int32(0)

    while i < n {
        a + b -> tmp
        b -> a
        tmp -> b
        i + one -> i
    }

    print a
}
