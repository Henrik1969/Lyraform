program bubblesort_compound

main {
    arr  : list<int32>([1,9,3,5,8,2,2,6,4])
    len  : int32(length(arr))
    zero : int32(0)
    one  : int32(1)
    i    : int32(0)
    j    : int32(0)
    tmp  : int32(0)

    while i < len {
        zero -> j

        while j + one < len {
            if arr[j] > arr[j + one] {
                arr[j] -> tmp
                arr[j + one] -> arr[j]
                tmp -> arr[j + one]
            }

            j + one -> j
        }

        i + one -> i
    }

    print arr
}
