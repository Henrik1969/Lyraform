program first_even_break

main {
    arr   : list<int32>([1,3,5,8,9])
    len   : int32(length(arr))
    zero  : int32(0)
    one   : int32(1)
    two   : int32(2)
    i     : int32(0)
    value : int32(0)
    rem   : int32(0)

    while i < len {
        arr[i] -> value
        value % two -> rem

        if rem == zero {
            print value
            break
        }

        i + one -> i
    }
}
