program fn_canonical_demo

fn square(n : c_int): c_int {
    n * n -> return
}

fn add_then_square(a : c_int, b : c_int): c_int {
    sum : c_int(0)
    a + b -> sum
    square(sum) -> return
}

main {
    x : c_int(3)
    y : c_int(4)
    result : c_int(0)

    add_then_square(x, y) -> result
    return result
}
