import "../../std/math.flow"
import "../../std/collatz.flow"

program capable_imported

main {
    zero  : int32(0)
    one   : int32(1)
    two   : int32(2)
    three : int32(3)
    four  : int32(4)
    five  : int32(5)
    nine  : int32(9)
    ten   : int32(10)
    forty_two : int32(42)

    result : int32(0)

    identity(forty_two) -> result
    print result

    square(add(three, four)) -> result
    print result

    factorial(five) -> result
    print result

    collatz_next(five) -> result
    print result

    choose_larger(nine, four) -> result
    print result

    matrix : array<int32>[2, 3]([1,2,3,4,5,6])
    row    : int32(1)
    col    : int32(2)
    value  : int32(0)

    matrix[row, col] -> value
    print value

    value + ten -> matrix[row, col]
    print matrix
}
