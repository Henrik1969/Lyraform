program fn_collatz_next

fn collatz_next(n : int32): int32 {
    zero  : int32(0)
    two   : int32(2)
    three : int32(3)
    one   : int32(1)
    rem   : int32(0)

    n % two -> rem

    if rem == zero {
        n / two -> return
    } else {
        n * three + one -> return
    }
}

main {
    n   : int32(stdin.int())
    one : int32(1)

    while n > one {
        print n
        collatz_next(n) -> n
    }

    print n
}
