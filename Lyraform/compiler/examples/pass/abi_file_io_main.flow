import "../../std/abi/libc.flow"
import "../../std/abi/file_io.flow"

program abi_file_io_main

main {
    reader : c_int(open("/dev/zero", 0))
    writer : c_int(open("/dev/null", 1))
    failing_writer : c_int(open("/dev/full", 1))
    buffer : c_pointer(8)
    count : c_size_t(8)
    read_count : c_long(0)
    write_count : c_long(0)
    failure_count : c_long(0)
    expected : c_long(8)
    status : c_int(0)

    if reader >= 0 {
        read(reader, buffer, count) -> read_count
        if read_count == expected {
            puts("read bounded ok") -> status
        }
        close(reader) -> status
    }
    if writer >= 0 {
        write(writer, buffer, count) -> write_count
        if write_count == expected {
            puts("write bounded ok") -> status
        }
        close(writer) -> status
    }
    if failing_writer >= 0 {
        write(failing_writer, buffer, count) -> failure_count
        if failure_count < 0 {
            puts("write failure ok") -> status
        }
        close(failing_writer) -> status
    }
}
