program collatz_structured

main {
    n     : int32(stdin.int())
    zero  : int32(0)
    one   : int32(1)
    two   : int32(2)
    three : int32(3)
    rem   : int32(0)
    tmp   : int32(0)

    while n > one {
        print n
        n % two -> rem

        if rem == zero {
            n / two -> n
        } else {
            n * three -> tmp
            tmp + one -> n
        }
    }

    print n
}
