program bubblesort_indexed_structured

main {
    arr   : list<int32>([1,9,3,5,8,2,2,6,4])
    len   : int32(length(arr))
    zero  : int32(0)
    one   : int32(1)
    i     : int32(0)
    j     : int32(0)
    next  : int32(0)
    a     : int32(0)
    b     : int32(0)

    while i < len {
        zero -> j

        while j < len {
            j + one -> next

            if next < len {
                arr[j] -> a
                arr[next] -> b

                if a > b {
                    b -> arr[j]
                    a -> arr[next]
                }
            }

            j + one -> j
        }

        i + one -> i
    }

    print arr
}
