import "../../std/abi/libc.flow"
import "../../std/abi/text.flow"

program text_runtime

fn join(left : Text, right : Text): Text {
    value : Text(left + right)
    return value
}

main {
    prefix : Text(join("Lyra", "form"))
    value : Text(join(prefix, " — Igor"))
    alternate : Text(join(prefix, " / tester"))
    print prefix
    print value
    print alternate
    print value
}
