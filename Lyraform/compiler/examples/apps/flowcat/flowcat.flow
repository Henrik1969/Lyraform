import "../../../std/abi/file_io.flow"

program flowcat

main(args : list<string>) {
    index : c_int(1)
    argument_count : c_int(length(args))
    one : c_int(1)
    zero : c_int(0)
    flags : c_int(0)
    stdout_fd : c_int(1)
    fd : c_int(-1)
    offset : c_pointer(0)
    capacity : c_size_t(1048576)
    count : c_long(0)
    count_zero : c_long(0)
    closed : c_int(0)

    while index < argument_count {
        path : c_string(args[index])
        open(path, flags) -> fd
        if fd < zero {
            one -> return
        }
        sendfile(stdout_fd, fd, offset, capacity) -> count
        while count > count_zero {
            sendfile(stdout_fd, fd, offset, capacity) -> count
        }
        if count < count_zero {
            close(fd) -> closed
            one -> return
        }
        close(fd) -> closed
        if closed < zero {
            one -> return
        }
        index + one -> index
    }
    zero -> return
}
