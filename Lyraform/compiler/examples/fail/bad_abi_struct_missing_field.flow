abi testabi {
    library "./build/libflowmini_testabi.so"
    convention c

    struct Point {
        x : c_int
        y : c_int
    }

    extern fn point_sum(p : Point): c_int {
        symbol "point_sum"
        effect pure
    }
}

program bad_abi_struct_missing_field

main {
    p : Point({x:10})
    result : c_int(0)
    point_sum(p) -> result
    print result
}
