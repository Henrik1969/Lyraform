program operator_expression_probe

fn square(n : int32) -> int32 {
    return n * n
}

main {
    x : int32(1)
    y : int32(2)
    z : int32(square(x))
    negative : int32(-1)

    x = y
    y = x + 1
    z = square(y)
    y = -x

    while x < 10 {
        x = x + 1
    }

    if x == 10 {
        y = y - 1
    }
}
