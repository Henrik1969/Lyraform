program call_expression_probe

fn square(n : c_int) -> c_int {
    return n * n
}

fn is_ready() -> Bool {
    return true
}

main {
    x : c_int(square(1))
    y : c_int(square(10))

    while is_ready() {
        z : c_int(square(15))
    }

    if is_ready() {
        w : c_int(square(20))
    }
}
