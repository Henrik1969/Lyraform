program ast_spacing_edgecases

fn compact(a:int32,b:int32):int32 {
    a + b -> return
}

fn spaced (
    a : int32,
    b : int32
) : int32 {
    a + b -> return
}

main {
    one : int32(1)
    two : int32(2)
    out : int32(0)

    compact(one, two) -> out
    print out

    spaced(one, two) -> out
    print out
}program ast_spacing_edgecases

