program index_field_probe

record Point {
    x : int32
    y : int32
}

main {
    arr : list<int32>([1, 2, 3])
    i : c_int(0)
    value : int32(arr[i])

    p : Point({x: 10, y: 20})
    xvalue : int32(p.x)

    value = arr[i]
    xvalue = p.y

    while arr[i] < 10 {
        value = arr[i]
    }

    if p.x == 10 {
        xvalue = p.y
    }
}
