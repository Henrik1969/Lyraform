program statement_else_probe

fn normalize(value : int32) -> int32 {
    if value > 0 {
        return value
    } else {
        return -value
    }
}

fn keep_or_one(value : int32) -> int32 {
    if value == 0 {
        return 1
    }

    return value
}

main {
    value : int32(1)

    if value > 0 {
        value = 2
    } else {
        if value == 0 {
            value = 3
        } else {
            value = 4
        }
    }
}
