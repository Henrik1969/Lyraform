program placement_statement_probe

type Gear {
    field teeth : int32
    field rpm : int32
}

type GearPair {
    field driver : Gear
    field driven : Gear
}

fn keep(value : int32): int32 {
    value -> return
}

main {
    scalar : int32(0)
    i : int32(0)
    j : int32(1)
    values : list<int32>([0, 0])
    matrix : array<int32>[2, 2]([0, 0, 0, 0])
    driver : Gear({teeth:12, rpm:100})
    driven : Gear({teeth:36, rpm:0})
    pair : GearPair({driver:driver, driven:driven})

    keep(scalar) -> scalar
    42 -> pair.driven.rpm
    42 -> values[i]
    42 -> matrix[i, j]
}
