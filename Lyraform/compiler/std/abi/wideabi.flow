unit std_abi_wideabi

abi wideabi {
    library "./build/libflowmini_testabi.so"
    convention c

    struct LongValue {
        value : c_long
    }

    extern fn long_input(): LongValue {
        symbol "long_input"
        effect pure
    }

    extern fn long_count(): c_size_t {
        symbol "long_count"
        effect readonly
    }

    extern fn long_item(index : c_size_t): LongValue {
        symbol "long_item"
        effect readonly
    }

    extern fn long_sum(value : LongValue): c_int {
        symbol "long_sum"
        effect pure
    }
}
