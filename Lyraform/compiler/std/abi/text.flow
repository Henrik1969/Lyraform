unit std_abi_text

abi text_runtime {
    library "libflowtext.so"
    convention c

    type Text {
        repr "const char*"
        ownership owned
        access read
        lifetime value
        nullable false
        terminator nul
    }

    extern fn concat(left : Text, right : Text): Text {
        symbol "flow_text_concat"
        effect memory
    }

    // Atomic backend-neutral carrier. The native provider returns the tagged
    // {code,value} value by value; host pointers never enter serialized plans.
    extern fn concat_outcome(left : Text, right : Text): TextOutcome {
        symbol "flow_text_concat_value"
        effect memory
    }

    extern fn dispose(value : Text): c_int {
        symbol "flow_text_dispose"
        effect memory
    }

    extern fn concat_status(left : Text, right : Text): c_int {
        symbol "flow_text_concat_status"
        effect memory
    }
}

type TextFailure refines c_int {
}

type TextOutcome {
    field code : TextFailure
    field value : Text
}
