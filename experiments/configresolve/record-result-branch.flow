program configresolve_record_result_branch

record Outcome {
 status : int32
 value : int32
}

target Demo {
fn choose(flag : int32): Outcome {
 if flag == 0 {
  zero : Outcome({status: 0, value: 11})
  zero -> return
 }
 one : Outcome({status: 0, value: 22})
 one -> return
}

fn read(result : Outcome): int32 {
 result.value -> return
}

main {
 selected : int32(read(choose(0)))
 selected -> return
}
}
