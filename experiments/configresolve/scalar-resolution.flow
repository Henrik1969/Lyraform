program configresolve_scalar_probe

// Bounded application algorithm: two integer facts for one valid key.
// Policy codes: 0 highest precedence, 1 reject conflict, 2 first, 3 last.
// Result codes: 1/2 successful candidate identity, 11 ambiguity, 12 conflict.
// Failed resolution never exposes a candidate as authoritative.
fn resolve_pair(a : int32, ap : int32, b : int32, bp : int32, mode : int32): int32 {
    first : int32(1)
    second : int32(2)
    highest : int32(0)
    reject : int32(1)
    first_policy : int32(2)
    last_policy : int32(3)
    ambiguity : int32(11)
    conflict : int32(12)

    if mode == first_policy {
        first -> return
    }
    if mode == last_policy {
        second -> return
    }
    if mode == reject {
        if a != b {
            conflict -> return
        }
    }
    if mode == highest {
        if ap == bp {
            if a != b {
                ambiguity -> return
            }
        }
    }
    if ap > bp {
        first -> return
    }
    second -> return
}

main {
    a : int32(7)
    ap : int32(10)
    b : int32(19)
    bp : int32(30)
    mode : int32(0)
    result : int32(0)
    resolve_pair(a, ap, b, bp, mode) -> result
    result -> return
}
