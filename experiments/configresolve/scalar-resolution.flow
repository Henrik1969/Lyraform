program configresolve_scalar_probe

// Bounded application algorithm: two integer facts for one valid key.
// Policy codes: 0 highest precedence, 1 reject conflict, 2 first, 3 last.
// Result codes: 1/2 successful candidate identity, 11 ambiguity, 12 conflict.
// Failed resolution never exposes a candidate as authoritative.
fn resolve_pair(a : int, ap : int, b : int, bp : int, mode : int): int {
    first : int(1)
    second : int(2)
    highest : int(0)
    reject : int(1)
    first_policy : int(2)
    last_policy : int(3)
    ambiguity : int(11)
    conflict : int(12)

    if mode == first_policy {
        first -> return
    }
    if mode == last_policy {
        second -> return
    }
    if mode == reject {
        if a != b {
            conflict -> return
        }
    }
    if mode == highest {
        if ap == bp {
            if a != b {
                ambiguity -> return
            }
        }
    }
    if ap > bp {
        first -> return
    }
    second -> return
}

main {
    a : int(7)
    ap : int(10)
    b : int(19)
    bp : int(30)
    mode : int(0)
    result : int(0)
    resolve_pair(a, ap, b, bp, mode) -> result
    result -> return
}
